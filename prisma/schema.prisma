generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  // Managers may optionally be granted access to financial data (prices, revenue).
  canViewFinancials Boolean @default(false)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee  Employee?
  sessions  Session[]
  auditLogs AuditLog[]
  notes     Note[]
}

model Session {
  id        String   @id @default(cuid())
  // sha256 hash of the opaque session token; the raw token only lives in the cookie
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// People
// ─────────────────────────────────────────────

model Employee {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  email     String?
  skills    String[] @default([])
  active    Boolean  @default(true)
  notes     String?
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectMemberships ProjectEmployee[]
  scheduleEntries    ScheduleEntryEmployee[]
  managedProjects    Project[]               @relation("ProjectManager")
  templateMemberships TemplateEmployee[]
  managedTemplates    ProjectTemplate[]      @relation("TemplateManager")
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  company       String?
  contactPerson String?
  phone         String?
  email         String?
  street        String?
  city          String?
  postalCode    String?
  latitude      Float?
  longitude     Float?
  country       String?  @default("Deutschland")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
}

// ─────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────

enum ProjectStatus {
  LEAD
  QUOTED
  APPROVED
  PLANNED
  IN_PROGRESS
  COMPLETED
  INVOICED
  PAID
  CANCELLED
}

// Configurable work categories (Malern, Putz, Trockenbau, ...). Admin-managed.
model WorkCategory {
  id        String  @id @default(cuid())
  nameDe    String
  nameEn    String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  projects  ProjectWorkCategory[]
  templates ProjectTemplate[]
}

model Project {
  id            String        @id @default(cuid())
  // Human-readable sequential number, e.g. "2026-0048"
  number        String        @unique
  name          String
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        ProjectStatus @default(LEAD)
  // Configurable in Settings (AppSetting `clientTypes` / `buildingTypes`)
  clientType    String?
  buildingType  String?

  // Site address (may differ from customer address)
  street     String?
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  phone      String?
  contact    String?

  // Financial — restricted to users with canViewFinancials / ADMIN
  price Decimal? @db.Decimal(12, 2)
  // Subcontractor job ("SUB" section in the Monatsplanumsatz sheet)
  isSub Boolean  @default(false)

  plannedStart DateTime? @db.Date
  plannedEnd   DateTime? @db.Date
  actualStart  DateTime? @db.Date
  actualEnd    DateTime? @db.Date

  managerId String?
  manager   Employee? @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)


  description String?
  // Internal notes visible to management only
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workCategories  ProjectWorkCategory[]
  team            ProjectEmployee[]
  vehicles        ProjectVehicle[]
  items           ProjectItem[]
  scheduleEntries ScheduleEntry[]
  notes           Note[]
  documents       Document[]

  @@index([customerId])
  @@index([status])
}

model ProjectWorkCategory {
  projectId      String
  workCategoryId String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workCategory   WorkCategory @relation(fields: [workCategoryId], references: [id], onDelete: Cascade)

  @@id([projectId, workCategoryId])
}

// Vehicles planned for the project (defaults for new schedule entries).
model ProjectVehicle {
  projectId String
  vehicleId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, vehicleId])
  @@index([vehicleId])
}

model ProjectEmployee {
  projectId  String
  employeeId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([projectId, employeeId])
}

// ─────────────────────────────────────────────
// Vehicles
// ─────────────────────────────────────────────

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  OUT_OF_SERVICE
}

model Vehicle {
  id           String        @id @default(cuid())
  name         String
  licensePlate String?
  type         String?
  status       VehicleStatus @default(AVAILABLE)
  notes        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  projects        ProjectVehicle[]
  templates       TemplateVehicle[]
  scheduleEntries ScheduleEntryVehicle[]
}

// ─────────────────────────────────────────────
// Tools & Materials (one catalog, two kinds)
// ─────────────────────────────────────────────

model CatalogItem {
  id       String   @id @default(cuid())
  // Configurable in Settings (AppSetting `itemKinds`) — TOOL / MATERIAL by default
  kind     String
  name     String
  category String?
  unit     String?
  // Inventory fields — minimal for MVP, extended later
  stockQuantity Decimal? @db.Decimal(12, 2)
  minStock      Decimal? @db.Decimal(12, 2)
  location      String?
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projectItems  ProjectItem[]
  templateItems TemplateItem[]

  @@index([kind])
}

enum ProjectItemStatus {
  REQUIRED
  COLLECTED
  MISSING
}

// A tool/material required for a specific project (the warehouse checklist)
model ProjectItem {
  id            String            @id @default(cuid())
  projectId     String
  catalogItemId String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem       @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  quantity      Decimal?          @db.Decimal(12, 2)
  status        ProjectItemStatus @default(REQUIRED)
  note          String?
  updatedAt     DateTime          @updatedAt

  @@unique([projectId, catalogItemId])
  @@index([projectId])
}

// ─────────────────────────────────────────────
// Project Templates
// ─────────────────────────────────────────────

model ProjectTemplate {
  id             String        @id @default(cuid())
  name           String
  workCategoryId String?
  workCategory   WorkCategory? @relation(fields: [workCategoryId], references: [id], onDelete: SetNull)
  description    String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Optional default assignment copied into new projects
  managerId String?
  manager   Employee? @relation("TemplateManager", fields: [managerId], references: [id], onDelete: SetNull)

  items     TemplateItem[]
  vehicles  TemplateVehicle[]
  employees TemplateEmployee[]
}

model TemplateVehicle {
  templateId String
  vehicleId  String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([templateId, vehicleId])
  @@index([vehicleId])
}

model TemplateEmployee {
  templateId String
  employeeId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([templateId, employeeId])
  @@index([employeeId])
}

model TemplateItem {
  id            String          @id @default(cuid())
  templateId    String
  catalogItemId String
  template      ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem     @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  quantity      Decimal?        @db.Decimal(12, 2)

  @@unique([templateId, catalogItemId])
}

// ─────────────────────────────────────────────
// Scheduling
// ─────────────────────────────────────────────

// One entry = one project on one day, with a team and optionally a vehicle.
// The weekly board is built from these entries; conflicts are detected across
// entries sharing the same date.
model ScheduleEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  startTime String? // "07:30" — optional; both empty = all-day
  endTime   String? // "13:00"
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees ScheduleEntryEmployee[]
  vehicles  ScheduleEntryVehicle[]

  @@unique([projectId, date])
  @@index([date])
}

model ScheduleEntryVehicle {
  scheduleEntryId String
  vehicleId       String
  scheduleEntry   ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([scheduleEntryId, vehicleId])
  @@index([vehicleId])
}

model ScheduleEntryEmployee {
  scheduleEntryId String
  employeeId      String
  scheduleEntry   ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([scheduleEntryId, employeeId])
  @@index([employeeId])
}

// ─────────────────────────────────────────────
// Notes, Documents, Audit
// ─────────────────────────────────────────────

enum NoteVisibility {
  TEAM       // visible to assigned employees
  MANAGEMENT // admin/manager only
}

model Note {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  visibility NoteVisibility @default(TEAM)
  body       String
  createdAt  DateTime       @default(now())

  @@index([projectId])
}

model Document {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  path      String
  createdAt DateTime @default(now())

  @@index([projectId])
}

// Small app-wide key/value settings (e.g. the uploaded company logo)
model AppSetting {
  key   String @id
  value String
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String // e.g. "project.update", "projectItem.status"
  entity   String // e.g. "Project"
  entityId String
  field    String?
  oldValue String?
  newValue String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
