generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  passwordHash      String
  role              Role     @default(EMPLOYEE)
  // Managers may optionally be granted access to financial data (prices, revenue).
  canViewFinancials Boolean  @default(false)
  active            Boolean  @default(true)
  // Personal dashboard layout (order, hidden widgets, widths) as JSON.
  dashboardLayout   String?
  /// When the user last opened the list of comments naming them; what came after is new.
  mentionsSeenAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee          Employee?
  sessions          Session[]
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
  notes             Note[]
  uploadedDocuments Document[]         @relation("DocumentUploader")
  timeEntryEdits    TimeEntry[]        @relation("TimeEntryEditor")
  deviceHandouts    DeviceAssignment[] @relation("DeviceAssignmentEditor")
  readyInvoices     ProjectInvoice[]   @relation("InvoiceReadyBy")
}

model Session {
  id        String   @id @default(cuid())
  // sha256 hash of the opaque session token; the raw token only lives in the cookie
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// People
// ─────────────────────────────────────────────

/// Where the app tells an automation — n8n, for one — that something
/// happened. Each event is signed with the endpoint's secret, which the
/// receiver checks; the secret is kept in the clear because the app needs it
/// to sign.
model WebhookEndpoint {
  id         String            @id @default(cuid())
  name       String
  url        String
  secret     String
  /// The events it receives — names from src/lib/webhook-events.ts.
  events     String[]          @default([])
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]
}

/// One event on its way to one endpoint: queued, sent, retried until it is
/// taken or the attempts run out.
model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          String
  /// The whole body as sent: id, event, occurredAt, data.
  payload        Json
  /// pending | delivered | failed
  status         String          @default("pending")
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  responseStatus Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

/// A key for a program outside the app — an automation, an AI assistant via
/// MCP — that acts as one user of the app: same role, same financial access.
/// Only the hash is kept; the key itself is shown once, when it is made.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  /// The key's first characters, so a person can tell keys apart in a list.
  prefix     String
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Employee {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  email     String?
  skills    String[] @default([])
  active    Boolean  @default(true)
  notes     String?
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectMemberships  ProjectEmployee[]
  scheduleEntries     ScheduleEntryEmployee[]
  managedProjects     Project[]               @relation("ProjectManager")
  templateMemberships TemplateEmployee[]
  checkedItems        ProjectChecklistItem[]  @relation("ChecklistCheckedBy")
  deviceAssignments   DeviceAssignment[]
  managedTemplates    ProjectTemplate[]       @relation("TemplateManager")
  absences            Absence[]
  timeEntries         TimeEntry[]
}

/// Holiday, sick leave and other absences — the planner warns about them.
model Absence {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  /// VACATION | SICK | OTHER
  type       String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([startDate, endDate])
}

/// One work interval (start/stop on the phone, corrections in the office).
/// `endedAt` null = still running; `source`: worker | office | import.
model TimeEntry {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  startedAt   DateTime
  endedAt     DateTime?
  note        String?
  source      String    @default("worker")
  createdById String?
  createdBy   User?     @relation("TimeEntryEditor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId, startedAt])
  @@index([projectId])
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  /// The customer's number in the office's own books (the quotation software's
  /// customer number). Free text and not unique: it is copied in by hand or by
  /// an import, and two spellings of one customer must not block a save.
  number        String?
  company       String?
  contactPerson String?
  phone         String?
  email         String?
  street        String?
  city          String?
  postalCode    String?
  latitude      Float?
  longitude     Float?
  country       String?  @default("Deutschland")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]

  @@index([number])
}

// ─────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────

enum ProjectStatus {
  LEAD
  QUOTED
  APPROVED
  PLANNED
  IN_PROGRESS
  COMPLETED
  INVOICED
  PAID
  CANCELLED
}

// Configurable work categories (Malern, Putz, Trockenbau, ...). Admin-managed.
model WorkCategory {
  id        String  @id @default(cuid())
  nameDe    String
  nameEn    String
  /// The colour its label wears on the board — a key from src/lib/board-cards.ts; null lets the app pick one.
  color     String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  projects  ProjectWorkCategory[]
  templates ProjectTemplate[]
}

model Project {
  id              String        @id @default(cuid())
  // Human-readable sequential number, e.g. "2026-0048"
  number          String        @unique
  name            String
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  status          ProjectStatus @default(LEAD)
  // Configurable in Settings (AppSetting `clientTypes` / `buildingTypes`)
  clientType      String?
  buildingType    String?
  /// empty = normal, HIGH | LOW
  priority        String?
  /// Where the request came from — configurable list in Settings.
  leadSource      String?
  /// Link back to the source record (board card, import row …).
  externalSystem  String?
  externalId      String?
  externalUrl     String?
  /// When the record came into being in the source system — a board card's
  /// creation time, for instance. Not the import time (that is createdAt).
  sourceCreatedAt DateTime?

  // Site address (may differ from customer address)
  street     String?
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  phone      String?
  contact    String?

  // Financial — restricted to users with canViewFinancials / ADMIN
  price Decimal? @db.Decimal(12, 2)
  // Subcontractor job ("SUB" section in the Monatsplanumsatz sheet)
  isSub Boolean  @default(false)

  plannedStart DateTime? @db.Date
  plannedEnd   DateTime? @db.Date
  /// The day the work has to be done by — a promise to the customer, not a plan
  /// of the office's own. Apart from plannedEnd on purpose: a job can be planned
  /// to end well before it is due, or be planned past it, which is the warning.
  dueDate      DateTime? @db.Date
  actualStart  DateTime? @db.Date
  actualEnd    DateTime? @db.Date

  /// Lines of the year-planning sheet that were tied to this project.
  planEntries PlanEntry[]

  managerId String?
  manager   Employee? @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  description   String?
  // Internal notes visible to management only
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Follow-on offers ("Nachträge") that increase the order value
  addOns          ProjectAddOn[]
  workCategories  ProjectWorkCategory[]
  team            ProjectEmployee[]
  vehicles        ProjectVehicle[]
  items           ProjectItem[]
  scheduleEntries ScheduleEntry[]
  notes           Note[]
  documents       Document[]
  timeEntries     TimeEntry[]
  checklists      ProjectChecklist[]
  devices         DeviceAssignment[]
  deviceNeeds     ProjectDevice[]
  /// Its records in other systems: the Trello card, the Wattro project.
  links           ProjectLink[]
  /// The two halves it is billed in, once the office marked them ready.
  invoices        ProjectInvoice[]

  @@index([customerId])
  @@index([status])
  @@index([externalSystem, externalId])
}

/// A project's record in another system — its Trello card, its Wattro
/// project. One per system per project, and one project per record, so an
/// automation can find the project by what it knows from the other side.
model ProjectLink {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "trello", "wattro" … lower case.
  system     String
  externalId String
  url        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([system, externalId])
  @@unique([projectId, system])
}

/// A job is billed in two halves: the first invoice (Abschlagsrechnung, 50 %)
/// and the final one (Schlussrechnung). The invoice itself is written in the
/// accounting program; the row stands for the office marking it ready, which
/// tells automations to prepare the e-mail. No row, not ready.
model ProjectInvoice {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 1 = the first half, 2 = the final invoice.
  part      Int
  /// Its number in the accounting program, when the office typed it in.
  number    String?
  amount    Decimal? @db.Decimal(12, 2)
  readyAt   DateTime @default(now())
  readyById String?
  readyBy   User?    @relation("InvoiceReadyBy", fields: [readyById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, part])
}

model ProjectWorkCategory {
  projectId      String
  workCategoryId String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workCategory   WorkCategory @relation(fields: [workCategoryId], references: [id], onDelete: Cascade)

  @@id([projectId, workCategoryId])
}

// A follow-on offer accepted after the main order — counts into the order
// value everywhere (project page, revenue, pipeline, customer report).
model ProjectAddOn {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([projectId])
}

// Vehicles planned for the project (defaults for new schedule entries).
model ProjectVehicle {
  projectId String
  vehicleId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, vehicleId])
  @@index([vehicleId])
}

model ProjectEmployee {
  projectId  String
  employeeId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([projectId, employeeId])
}

// ─────────────────────────────────────────────
// Vehicles
// ─────────────────────────────────────────────

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  OUT_OF_SERVICE
}

/// A single physical machine or device — the thing that gets handed out.
model Device {
  id              String   @id @default(cuid())
  name            String
  /// The number written on the device, if they use one.
  inventoryNo     String?
  category        String?
  storageLocation String?
  notes           String?
  /// Short instruction video for the crew.
  videoUrl        String?
  active          Boolean  @default(true)
  /// Filled when the row comes from an outside system later.
  externalSystem  String?
  externalId      String?
  source          String   @default("manual")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments DeviceAssignment[]
  templates   TemplateDevice[]
  projects    ProjectDevice[]

  @@unique([externalSystem, externalId])
  @@index([active])
}

/// "This job needs that machine" — a wish list, not a booking.
model TemplateDevice {
  templateId String
  deviceId   String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  device     Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([templateId, deviceId])
  @@index([deviceId])
}

model ProjectDevice {
  projectId String
  deviceId  String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  device    Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([projectId, deviceId])
  @@index([deviceId])
}

/// One handout: the device is on a site or with a person until it comes back.
model DeviceAssignment {
  id          String    @id @default(cuid())
  deviceId    String
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  takenAt     DateTime  @default(now())
  returnedAt  DateTime?
  note        String?
  createdById String?
  createdBy   User?     @relation("DeviceAssignmentEditor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([deviceId, returnedAt])
  @@index([projectId])
  @@index([employeeId])
}

model Vehicle {
  id           String        @id @default(cuid())
  name         String
  licensePlate String?
  type         String?
  status       VehicleStatus @default(AVAILABLE)
  notes        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  projects        ProjectVehicle[]
  templates       TemplateVehicle[]
  scheduleEntries ScheduleEntryVehicle[]
}

// ─────────────────────────────────────────────
// Tools & Materials (one catalog, two kinds)
// ─────────────────────────────────────────────

model CatalogItem {
  id            String   @id @default(cuid())
  // Configurable in Settings (AppSetting `itemKinds`) — TOOL / MATERIAL by default
  kind          String
  name          String
  category      String?
  unit          String?
  // Inventory fields — minimal for MVP, extended later
  stockQuantity Decimal? @db.Decimal(12, 2)
  minStock      Decimal? @db.Decimal(12, 2)
  location      String?
  notes         String?
  /// Link to a short "how to operate this device" video.
  videoUrl      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projectItems  ProjectItem[]
  templateItems TemplateItem[]

  @@index([kind])
}

enum ProjectItemStatus {
  REQUIRED
  COLLECTED
  MISSING
}

// A tool/material required for a specific project (the warehouse checklist)
model ProjectItem {
  id            String            @id @default(cuid())
  projectId     String
  catalogItemId String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem       @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  quantity      Decimal?          @db.Decimal(12, 2)
  status        ProjectItemStatus @default(REQUIRED)
  note          String?
  updatedAt     DateTime          @updatedAt

  @@unique([projectId, catalogItemId])
  @@index([projectId])
}

// ─────────────────────────────────────────────
// Project Templates
// ─────────────────────────────────────────────

model ProjectTemplate {
  id             String        @id @default(cuid())
  name           String
  workCategoryId String?
  workCategory   WorkCategory? @relation(fields: [workCategoryId], references: [id], onDelete: SetNull)
  description    String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Optional default assignment copied into new projects
  managerId String?
  manager   Employee? @relation("TemplateManager", fields: [managerId], references: [id], onDelete: SetNull)

  items       TemplateItem[]
  vehicles    TemplateVehicle[]
  employees   TemplateEmployee[]
  checklists  TemplateChecklist[]
  deviceNeeds TemplateDevice[]
}

model TemplateVehicle {
  templateId String
  vehicleId  String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([templateId, vehicleId])
  @@index([vehicleId])
}

model TemplateChecklist {
  templateId          String
  checklistTemplateId String
  template            ProjectTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  checklistTemplate   ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@id([templateId, checklistTemplateId])
  @@index([checklistTemplateId])
}

model TemplateEmployee {
  templateId String
  employeeId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([templateId, employeeId])
  @@index([employeeId])
}

model TemplateItem {
  id            String          @id @default(cuid())
  templateId    String
  catalogItemId String
  template      ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem     @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  quantity      Decimal?        @db.Decimal(12, 2)

  @@unique([templateId, catalogItemId])
}

// ─────────────────────────────────────────────
// Site checklists (Baustellen-Checklisten)
// ─────────────────────────────────────────────

// Reusable checklist, e.g. "Übernahme vom Vorgewerk".
model ChecklistTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     ChecklistTemplateItem[]
  templates TemplateChecklist[]
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text       String
  sortOrder  Int               @default(0)

  @@index([templateId])
}

// A checklist attached to one project — ticked off on site.
model ProjectChecklist {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  templateId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items ProjectChecklistItem[]

  @@index([projectId])
}

model ProjectChecklistItem {
  id          String           @id @default(cuid())
  checklistId String
  checklist   ProjectChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  sortOrder   Int              @default(0)
  /**
   * null = open, true = in order, false = problem (note says what).
   */
  ok          Boolean?
  note        String?
  checkedAt   DateTime?
  checkedById String?
  checkedBy   Employee?        @relation("ChecklistCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@index([checkedById])
}

// ─────────────────────────────────────────────
// Scheduling
// ─────────────────────────────────────────────

// One entry = one project on one day, with a team and optionally a vehicle.
// The weekly board is built from these entries; conflicts are detected across
// entries sharing the same date.
model ScheduleEntry {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  startTime   String? // "07:30" — optional; both empty = all-day
  endTime     String? // "13:00"
  note        String?
  // Set when the day was taken out of the plan (e.g. the project was completed
  // earlier). Such entries are hidden everywhere and ignored by conflicts,
  // reports and packing — but can be restored when the project is reopened.
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees ScheduleEntryEmployee[]
  vehicles  ScheduleEntryVehicle[]

  @@unique([projectId, date])
  @@index([date])
  @@index([cancelledAt])
}

model ScheduleEntryVehicle {
  scheduleEntryId String
  vehicleId       String
  scheduleEntry   ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([scheduleEntryId, vehicleId])
  @@index([vehicleId])
}

model ScheduleEntryEmployee {
  scheduleEntryId String
  employeeId      String
  scheduleEntry   ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([scheduleEntryId, employeeId])
  @@index([employeeId])
}

// ─────────────────────────────────────────────
// Notes, Documents, Audit
// ─────────────────────────────────────────────

enum NoteVisibility {
  TEAM // visible to assigned employees
  MANAGEMENT // admin/manager only
}

model Note {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  visibility NoteVisibility @default(TEAM)
  body       String
  /// The users named with @ in the body, so an automation can tell them.
  mentions   String[]       @default([])
  createdAt  DateTime       @default(now())

  @@index([projectId])
}

/// A file on a project (plan, offer PDF, photo). `path` is the storage key
/// under FILE_STORAGE_DIR; `source` says where the file came from (manual
/// upload, later: card, mail, extraction). Crew accounts only ever see files
/// with `visibleToCrew` — offers with prices stay office-only by default.
model Document {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  size          Int
  path          String   @unique
  source        String   @default("manual")
  visibleToCrew Boolean  @default(false)
  uploadedById  String?
  uploadedBy    User?    @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([projectId])
}

// Small app-wide key/value settings (e.g. the uploaded company logo)
// ─────────────────────────────────────────────
// Boards
// ─────────────────────────────────────────────

/// A board of the projects page: a name and its columns. Each column is one
/// status, so a card dragged into it changes the project's status and nothing
/// else has to be kept in step; a project stands on every board that has a
/// column for its status. Several boards, so the office side can look at the
/// enquiries and the offers and the site side at what is being built, each on
/// a board of its own — the way their Trello was laid out.
model Board {
  id         String        @id @default(cuid())
  name       String
  /// The ground the lists float on — a key from src/lib/boards.ts; null is the app's own.
  background String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  columns   BoardColumn[]
}

model BoardColumn {
  id        String        @id @default(cuid())
  boardId   String
  board     Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  status    ProjectStatus
  /// The column's own name on this board, when it is not the status's — "Angebot fertig" for QUOTED, say.
  title     String?
  /// Left to right, as the board was dragged into.
  sortOrder Int           @default(0)

  @@unique([boardId, status])
}

model AppSetting {
  key   String @id
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. "project.update", "projectItem.status"
  entity    String // e.g. "Project"
  entityId  String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Something that arrived from outside (Excel import, board automation, AI
/// extraction) and waits for the office to confirm it as a real project.
model ProjectDraft {
  id             String    @id @default(cuid())
  /// excel | api | extraction
  source         String
  /// open | done | dismissed
  status         String    @default("open")
  name           String
  customerName   String?
  street         String?
  postalCode     String?
  city           String?
  price          Decimal?  @db.Decimal(12, 2)
  plannedStart   DateTime? @db.Date
  plannedEnd     DateTime? @db.Date
  description    String?
  externalSystem String?
  externalId     String?
  externalUrl    String?
  payload        Json?
  /// Filled once the draft was taken over.
  projectId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([externalSystem, externalId])
  @@index([status])
}

/// One line of the year-planning sheet: a site and the net revenue planned for
/// it in that month. Imported from the office's own spreadsheet and held next
/// to what the projects actually add up to, so plan and reality can be
/// compared without anyone retyping the sheet.
model PlanEntry {
  id     String  @id @default(cuid())
  year   Int
  /// 1-12, or null when the sheet parks a site on a year without a month yet.
  month  Int?
  name   String
  amount Decimal @db.Decimal(12, 2)
  /// True for work planned for a subcontractor ("SUB" in the sheet).
  isSub  Boolean @default(false)
  /// excel | manual — where the row came from.
  source String  @default("excel")

  /// Set once the planned line is tied to the real project it became.
  /// Kept across a re-import: the link is re-applied by month + name.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([year, month])
  @@index([projectId])
}
