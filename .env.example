# PostgreSQL connection string
DATABASE_URL="postgresql://baucrew:CHANGE_ME@db:5432/baucrew?schema=public"
# Random secret, at least 32 chars. Generate with: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME"
# Used by docker-compose.yml for the postgres container
POSTGRES_PASSWORD="CHANGE_ME"
# Optional: key for the inbound automation endpoint (POST /api/inbound/drafts).
# Unset = the endpoint is disabled. Generate with: openssl rand -hex 32
# INBOUND_API_KEY=""

# Optional: where uploaded project files are stored (default: ./storage,
# in Docker a volume at /app/storage)
# FILE_STORAGE_DIR=""

# Optional: fetch the files attached to imported Trello cards (Settings →
# Import from Trello). A read-only token is enough; nothing is written to Trello.
# TRELLO_API_KEY=""
# TRELLO_TOKEN=""

# Optional: enable extra UI locales for local testing (comma-separated codes;
# needs a matching messages/<code>.json). Leave empty in production.
NEXT_PUBLIC_EXTRA_LOCALES=""

# Optional: Wattro tool-tracking integration (Devices page → "Mit Wattro
# abgleichen"). Server-side only, never exposed to the browser.
# Unset = the sync stays hidden and disabled.
# WATTRO_API_KEY=""
# Wattro API root (version and environment included). Confirm the right
# environment (dev vs. production) with the key's owner before pointing this
# at real data. In development the default is https://api-dev.wattro.io/api/v1;
# in production (NODE_ENV=production) there is no default — without this
# variable the sync stays off even when a key is set.
# WATTRO_BASE_URL=""
# Automatic Wattro sync, in minutes (default 60 in production; 0 = off;
# minimum 15). A development server stays off unless this is set.
# WATTRO_SYNC_INTERVAL_MINUTES=""
