# PostgreSQL connection string
DATABASE_URL="postgresql://baucrew:CHANGE_ME@db:5432/baucrew?schema=public"
# Random secret, at least 32 chars. Generate with: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME"
# Used by docker-compose.yml for the postgres container
POSTGRES_PASSWORD="CHANGE_ME"
# Optional: key for the inbound automation endpoint (POST /api/inbound/drafts).
# Unset = the endpoint is disabled. Generate with: openssl rand -hex 32
# INBOUND_API_KEY=""

# Optional: where uploaded project files are stored (default: ./storage,
# in Docker a volume at /app/storage)
# FILE_STORAGE_DIR=""

# Optional: fetch the files attached to imported Trello cards (Settings →
# Import from Trello). A read-only token is enough; nothing is written to Trello.
# TRELLO_API_KEY=""
# TRELLO_TOKEN=""
# How often the server brings the Trello boards switched on under Einstellungen →
# Trello in by itself, in minutes. Empty = every 60 minutes in production, off in
# development; 0 = off (the button still works); below 15 counts as 15.
# TRELLO_SYNC_INTERVAL_MINUTES=""

# Optional: enable extra UI locales for local testing (comma-separated codes;
# needs a matching messages/<code>.json). Leave empty in production.
NEXT_PUBLIC_EXTRA_LOCALES=""

# Optional: Wattro tool-tracking integration (Devices page → "Mit Wattro
# abgleichen"). Server-side only, never exposed to the browser.
# Unset = the sync stays hidden and disabled.
# WATTRO_API_KEY=""
# Wattro API root (version and environment included). Confirm the right
# environment (dev vs. production) with the key's owner before pointing this
# at real data. In development the default is https://api-dev.wattro.io/api/v1;
# in production (NODE_ENV=production) there is no default — without this
# variable the sync stays off even when a key is set.
# WATTRO_BASE_URL=""
# Automatic Wattro sync, in minutes (default 60 in production; 0 = off;
# minimum 15). A development server stays off unless this is set.
# WATTRO_SYNC_INTERVAL_MINUTES=""
# Writing projects to Wattro (the only thing this app ever writes there): set
# to 1 and a new project that is approved, planned or running is created in
# Wattro under its project number, and kept up to date. Off unless set.
# WATTRO_PROJECT_PUSH=""

# Optional: the in-app assistant (the ✦ button at the bottom right of the
# office pages). Server-side only, never sent to the browser or logged.
# Unset = the panel says "not set up yet" and nothing else changes.
# OPENAI_API_KEY=""
# Which OpenAI model answers (default gpt-5-mini).
# OPENAI_MODEL=""
# Only for an OpenAI-compatible endpoint other than api.openai.com.
# OPENAI_BASE_URL=""
# The same key writes out the voice notes of a project's documentation: the
# recording is sent to OpenAI for that. Model (default gpt-4o-mini-transcribe)
# and language of the recordings (ISO-639-1, default de).
# OPENAI_TRANSCRIBE_MODEL=""
# OPENAI_TRANSCRIBE_LANGUAGE=""
# Scanned quotes (PDFs without text) read by OpenAI for their sums and
# Vorgangsnummer. OFF unless "1": it sends the client's documents — prices,
# the customer's name and address — to OpenAI. PDFs with text never leave the
# server. Model default gpt-5-mini.
# QUOTE_OCR=""
# QUOTE_OCR_MODEL=""
# Signs the "Ausführen" confirmations so a changed browser cannot fake one.
# Default: derived from SESSION_SECRET; without either, a random key per
# server start (confirmations pending during a restart then have to be asked
# again). Generate with: openssl rand -hex 32
# ASSISTANT_APPROVAL_SECRET=""

# Optional, on a developer's machine only: the live site's feedback list for
# scripts/feedback-export.mjs, and the link in the comment bar's "Lokale Kopie"
# notice. The key is a "Nur Feedback-Aufgaben" key from the live site's
# Einstellungen → API-Schlüssel. Never set on the server itself.
# BAUCREW_LIVE_URL=""
# BAUCREW_LIVE_KEY=""
