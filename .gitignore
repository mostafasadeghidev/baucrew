# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (run `npx prisma generate`)
/src/generated/

# local-only company data — never commit
/prisma/seed.company.ts
/docs/screenshots/
/docs/*.pdf

# local tooling
.claude/settings.local.json

# local docker stack
/docker-compose.local.yml

# local-only test locales (see src/i18n/config.ts)
/messages/fa.json
